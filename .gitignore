# dependencies — a trailing slash matches only directories, so the
tracking symlinks a worktree uses would slip through
node_modules

# build output
dist/

# generated verification screenshots — regenerate with `pnpm shots`
shots/

# local recovery reports
.dsh-acl-recovery/

# logs and OS cruft
*.log
.DS_Store
Thumbs.db

apps/server/data/

# tsc incremental build info
*.tsbuildinfo

# git worktrees used for parallel agent work
.worktrees/

# environment variables & credentials
.env
.env.*
!.env.example
secrets.json

